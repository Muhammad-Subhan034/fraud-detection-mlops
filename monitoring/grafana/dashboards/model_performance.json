{
  "uid": "model-performance",
  "title": "🤖 Model Performance Dashboard",
  "tags": ["fraud-detection", "ml", "model"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Fraud Recall (Current)",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 },
      "targets": [
        { "expr": "fraud_model_recall", "legendFormat": "Recall", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0, "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.75 },
              { "color": "green", "value": 0.85 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "textMode": "value_and_name" }
    },
    {
      "id": 2,
      "title": "AUC-ROC Score",
      "type": "stat",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 5 },
      "targets": [
        { "expr": "fraud_model_auc_roc", "legendFormat": "AUC-ROC", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0, "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.85 },
              { "color": "green", "value": 0.90 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 3,
      "title": "Precision",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 5 },
      "targets": [
        { "expr": "fraud_model_precision", "legendFormat": "Precision", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0, "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.70 },
              { "color": "green", "value": 0.85 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 4,
      "title": "False Positive Rate",
      "type": "stat",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 5 },
      "targets": [
        { "expr": "fraud_false_positive_rate", "legendFormat": "FPR", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0, "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.05 },
              { "color": "red", "value": 0.10 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 5,
      "title": "Recall Over Time",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 9 },
      "targets": [
        { "expr": "fraud_model_recall", "legendFormat": "Recall", "refId": "A" },
        { "expr": "fraud_model_precision", "legendFormat": "Precision", "refId": "B" },
        { "expr": "fraud_model_f1", "legendFormat": "F1", "refId": "C" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0, "max": 1,
          "custom": { "lineWidth": 2, "fillOpacity": 8 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.75 },
              { "color": "green", "value": 0.85 }
            ]
          }
        }
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "id": 6,
      "title": "Prediction Volume by Class",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 9 },
      "targets": [
        { "expr": "rate(fraud_predictions_total{prediction='fraud'}[5m])", "legendFormat": "Fraud Rate", "refId": "A" },
        { "expr": "rate(fraud_predictions_total{prediction='non_fraud'}[5m])", "legendFormat": "Non-Fraud Rate", "refId": "B" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "lineWidth": 2, "fillOpacity": 15 }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Fraud Rate" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byName", "options": "Non-Fraud Rate" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] }
        ]
      }
    },
    {
      "id": 7,
      "title": "Prediction Confidence Distribution",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.25, rate(fraud_prediction_confidence_bucket[5m]))", "legendFormat": "p25 Confidence", "refId": "A" },
        { "expr": "histogram_quantile(0.50, rate(fraud_prediction_confidence_bucket[5m]))", "legendFormat": "p50 Confidence", "refId": "B" },
        { "expr": "histogram_quantile(0.75, rate(fraud_prediction_confidence_bucket[5m]))", "legendFormat": "p75 Confidence", "refId": "C" },
        { "expr": "histogram_quantile(0.95, rate(fraud_prediction_confidence_bucket[5m]))", "legendFormat": "p95 Confidence", "refId": "D" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } }
    },
    {
      "id": 8,
      "title": "Model Performance Summary",
      "type": "table",
      "gridPos": { "x": 12, "y": 14, "w": 12, "h": 8 },
      "targets": [
        { "expr": "fraud_model_recall", "legendFormat": "Recall", "refId": "A", "instant": true },
        { "expr": "fraud_model_precision", "legendFormat": "Precision", "refId": "B", "instant": true },
        { "expr": "fraud_model_f1", "legendFormat": "F1 Score", "refId": "C", "instant": true },
        { "expr": "fraud_model_auc_roc", "legendFormat": "AUC-ROC", "refId": "D", "instant": true }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "options": { "showHeader": true, "footer": { "show": false } }
    }
  ]
}
