# .env.example
# Copy this to .env and fill in your real values before running docker-compose.
# NEVER commit .env with real tokens to git.

# ── GitHub Actions Integration (Stage 4 CI/CD) ────────────────────────────────
# Personal Access Token with scopes: repo, workflow
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_token_here

# Your GitHub repository in "owner/repo" format
GITHUB_REPO=Muhammad-Subhan034/fraud-detection-mlops

# Branch to dispatch the retraining workflow on
GITHUB_REF=main

# ── Demo / Alert Forcing ──────────────────────────────────────────────────────
# Set FORCE_RECALL to a low value (e.g. 0.60) to force FraudRecallCritical alert
# Set FORCE_PSI to a high value (e.g. 0.55) to force DataDriftCritical alert
# Leave empty for normal (real trained-model) metric values
FORCE_RECALL=
FORCE_PSI=
