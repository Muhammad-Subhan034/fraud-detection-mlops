{
  "__inputs": [{"name": "DS_PROMETHEUS", "type": "datasource", "pluginId": "prometheus"}],
  "description": "ML Model Performance: Recall, Precision, Fraud Rate, Confidence Distribution",
  "panels": [
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "id": 200,
      "title": "Model Performance KPIs",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "unit": "percentunit",
          "min": 0, "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red",    "value": null},
              {"color": "yellow", "value": 0.70},
              {"color": "green",  "value": 0.80}
            ]
          }
        }
      },
      "gridPos": {"h": 5, "w": 4, "x": 0, "y": 1},
      "id": 201,
      "options": {"colorMode": "background", "graphMode": "area", "textMode": "auto"},
      "title": "🎯 Fraud Recall",
      "description": "Most critical metric — must stay above 80%",
      "type": "stat",
      "targets": [
        {
          "expr": "fraud_model_recall",
          "legendFormat": "Recall"
        }
      ]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0, "max": 1,
          "thresholds": {
            "steps": [
              {"color": "red",    "value": null},
              {"color": "yellow", "value": 0.15},
              {"color": "green",  "value": 0.25}
            ]
          }
        }
      },
      "gridPos": {"h": 5, "w": 4, "x": 4, "y": 1},
      "id": 202,
      "options": {"colorMode": "background"},
      "title": "Precision",
      "type": "stat",
      "targets": [{"expr": "1 - fraud_false_positive_rate", "legendFormat": "Precision"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0, "max": 1,
          "thresholds": {
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.10},
              {"color": "red",   "value": 0.15}
            ]
          }
        }
      },
      "gridPos": {"h": 5, "w": 4, "x": 8, "y": 1},
      "id": 203,
      "options": {"colorMode": "background"},
      "title": "False Positive Rate",
      "description": "Lower is better — keep below 10%",
      "type": "stat",
      "targets": [{"expr": "fraud_false_positive_rate", "legendFormat": "FPR"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 50},
              {"color": "red",   "value": 200}
            ]
          }
        }
      },
      "gridPos": {"h": 5, "w": 4, "x": 12, "y": 1},
      "id": 204,
      "options": {"colorMode": "value", "graphMode": "area"},
      "title": "Fraud Detections (last 5m)",
      "type": "stat",
      "targets": [
        {
          "expr": "increase(fraud_predictions_total{prediction=\"fraud\"}[5m])",
          "legendFormat": "Fraud flagged"
        }
      ]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "palette-classic"}
        }
      },
      "gridPos": {"h": 5, "w": 4, "x": 16, "y": 1},
      "id": 205,
      "options": {"colorMode": "value", "graphMode": "area"},
      "title": "Non-Fraud Detections (last 5m)",
      "type": "stat",
      "targets": [
        {
          "expr": "increase(fraud_predictions_total{prediction=\"non_fraud\"}[5m])",
          "legendFormat": "Non-fraud"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 6},
      "id": 210,
      "title": "Model Trends Over Time",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0, "max": 1,
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 2}
        }
      },
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 7},
      "id": 211,
      "options": {
        "tooltip": {"mode": "multi"},
        "legend": {"displayMode": "list", "placement": "bottom"}
      },
      "title": "Recall & Precision Trends",
      "type": "timeseries",
      "targets": [
        {
          "expr": "fraud_model_recall",
          "legendFormat": "Recall (target: >0.80)"
        },
        {
          "expr": "1 - fraud_false_positive_rate",
          "legendFormat": "Precision"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [{"color": "red", "value": 0}, {"color": "green", "value": 0.80}]
          }
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Recall (target: >0.80)"},
            "properties": [
              {"id": "custom.thresholdStyle", "value": {"mode": "line"}},
              {"id": "thresholds", "value": {"steps": [{"color": "red", "value": null}, {"color": "green", "value": 0.80}]}}
            ]
          }
        ]
      }
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "palette-classic"}
        }
      },
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 7},
      "id": 212,
      "title": "Fraud Detection Rate Over Time",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(fraud_predictions_total{prediction=\"fraud\"}[5m])",
          "legendFormat": "Fraud detections/s"
        },
        {
          "expr": "rate(fraud_predictions_total{prediction=\"non_fraud\"}[5m])",
          "legendFormat": "Non-fraud/s"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 16},
      "id": 220,
      "title": "Prediction Confidence Distribution",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {"unit": "short", "color": {"mode": "palette-classic"}}
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 17},
      "id": 221,
      "title": "Prediction Probability Distribution (histogram)",
      "description": "Should show bimodal distribution — high confidence for both classes",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.10, rate(fraud_prediction_confidence_bucket[10m]))",
          "legendFormat": "p10"
        },
        {
          "expr": "histogram_quantile(0.50, rate(fraud_prediction_confidence_bucket[10m]))",
          "legendFormat": "p50 (median)"
        },
        {
          "expr": "histogram_quantile(0.90, rate(fraud_prediction_confidence_bucket[10m]))",
          "legendFormat": "p90"
        }
      ]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {"unit": "short", "color": {"mode": "palette-classic"}}
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 17},
      "id": 222,
      "title": "Active Requests & Throughput",
      "type": "timeseries",
      "targets": [
        {
          "expr": "fraud_api_active_requests",
          "legendFormat": "Active requests"
        },
        {
          "expr": "sum(rate(fraud_api_requests_total[1m]))",
          "legendFormat": "Total req/s"
        }
      ]
    }
  ],
  "refresh": "15s",
  "schemaVersion": 38,
  "tags": ["fraud-detection", "ml", "model-performance"],
  "time": {"from": "now-6h", "to": "now"},
  "title": "Fraud Detection - Model Performance",
  "uid": "fraud-model-performance",
  "version": 1
}
